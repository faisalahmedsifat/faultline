{
  "name": "@xyph3r/faultline",
  "version": "0.1.2",
  "description": "Self-hosted error tracking SDK. Zero dependencies, works everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/faisalahmedsifat/faultline.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "error-tracking",
    "error-monitoring",
    "self-hosted",
    "sentry-alternative",
    "typescript"
  ],
  "author": "Faisal Ahmed Sifat",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "bin": {
    "faultline": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json",
    "release": "tsc -p tsconfig.json && npm publish",
    "release:dry": "tsc -p tsconfig.json && npm publish --dry-run"
  }
}
